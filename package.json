    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdf-lib": "1.17.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
